        <button style={styles.primary}>
          Download
        </button>
      </div>
    );
  }

  // 💰 PLANS SCREEN
  if (screen === "plans") {
    return (
      <div style={styles.container}>
        <h2>Unlimited Access</h2>

        <div style={styles.card}>
          <h3>Hessa Unlimited</h3>
