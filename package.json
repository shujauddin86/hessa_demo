import React, { useState } from "react";

function App() {
  const [screen, setScreen] = useState("home");

  // 🔐 LOGIN SCREEN
  if (screen === "login") {
    return (
      <div style={styles.container}>
        <h2>Login to Hessa</h2>

        <button style={styles.primary}>Continue with Google</button>
        <button style={styles.secondary}>Continue with Phone</button>
        <button style={styles.secondary}>Continue with Email</button>

        <br /><br />
        <button onClick={() => setScreen("home")} style={styles.link}>
          Back
        </button>
      </div>
